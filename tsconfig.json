{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "paths": { "@site/*": ["./*"] },
    "types": ["@mdx-js/react"],
    "skipLibCheck": true
  },
  "include": ["src", "docs", "blog", "docusaurus.config.ts"],
  "exclude": [".docusaurus", "build"]
}
